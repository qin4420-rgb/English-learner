# OneDrive personal account OAuth. Keep real values in hosted runtime secrets.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TOKEN_KEY=
ONEDRIVE_REDIRECT_URI=https://scott-english-room.qin4420.chatgpt.site/api/onedrive/callback

# Optional AI enrichment for summaries, translations and vocabulary extraction.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
AI_PROVIDER=deepseek

# Future document and speech providers. Empty means not configured.
